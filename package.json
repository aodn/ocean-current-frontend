{
  "name": "ocean-current-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:log": "VITE_PROXY_LOG=true vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc && vite build",
    "build:edge": "tsc && vite build --mode edge",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:production": "PLAYWRIGHT_TEST_BASE_URL=https://oceancurrent.production.aodn.org.au E2E_SMOKE=true playwright test",
    "test:e2e:report": "playwright show-report",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix --cache",
    "prettier": "prettier . --check ",
    "prettier:fix": "prettier . --write",
    "preview": "vite preview",
    "preview:build": "tsc && vite build && vite preview",
    "postinstall": "husky && scripts/setup-worktree.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "gifshot": "^0.4.5",
    "mapbox-gl": "^3.24.0",
    "node-html-parser": "^7.0.1",
    "react": "^18.3.1",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.1.1",
    "react-router": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.61.1",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "baseline-browser-mapping": "^2.9.0",
    "commitlint-config-gitmoji": "^2.3.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^17.0.5",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^7.3.3",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.6",
    "vitest-canvas-mock": "^1.1.4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --report-unused-disable-directives --max-warnings 0"
    ],
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
