{
  "name": "ocean-current-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:log": "VITE_PROXY_LOG=true vite",
    "build": "tsc && vite build",
    "build:edge": "tsc && vite build --mode edge",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:production": "PLAYWRIGHT_TEST_BASE_URL=https://oceancurrent.production.aodn.org.au E2E_SMOKE=true playwright test",
    "test:e2e:report": "playwright show-report",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix --cache",
    "prettier": "prettier . --check ",
    "prettier:fix": "prettier . --write",
    "preview": "vite preview",
    "preview:build": "tsc && vite build && vite preview",
    "postinstall": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.79.0",
    "@tanstack/react-query-devtools": "^5.79.0",
    "@types/gtag.js": "^0.0.20",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "gifshot": "^0.4.5",
    "mapbox-gl": "^3.12.0",
    "node-html-parser": "^7.0.1",
    "react": "^18.3.1",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.0.4",
    "react-router": "^7.6.1",
    "vitest-canvas-mock": "^0.3.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.57.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.7",
    "@types/react": "^18.3.12",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.0",
    "commitlint-config-gitmoji": "^2.3.1",
    "dotenv": "^17.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^2.1.5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --report-unused-disable-directives --max-warnings 0"
    ],
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.1.0"
}
